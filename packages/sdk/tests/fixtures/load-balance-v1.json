  "pickCases": [
    {
      "name": "random 0 picks the first key",
      "keys": [
        {
          "alias": "primary",
          "weight": 50
        },
        {
          "alias": "secondary",
          "weight": 30
        },
        {
          "alias": "overflow",
          "weight": 20
        }
      ],
      "input": {
        "random": 0,
        "now": 1000
      },
      "expected": "primary"
    },
    {
      "name": "random 0.49 is still within the first key's half",
      "keys": [
        {
          "alias": "primary",
          "weight": 50
        },
        {
          "alias": "secondary",
          "weight": 30
        },
        {
          "alias": "overflow",
          "weight": 20
        }
      ],
      "input": {
        "random": 0.49,
        "now": 1000
      },
      "expected": "primary"
    },
    {
      "name": "random 0.5 starts the second key",
      "keys": [
        {
          "alias": "primary",
          "weight": 50
        },
        {
          "alias": "secondary",
          "weight": 30
        },
        {
          "alias": "overflow",
          "weight": 20
        }
      ],
      "input": {
        "random": 0.5,
        "now": 1000
      },
      "expected": "secondary"
    },
    {
      "name": "random 0.8 starts the third key",
      "keys": [
        {
          "alias": "primary",
          "weight": 50
        },
        {
          "alias": "secondary",
          "weight": 30
        },
        {
          "alias": "overflow",
          "weight": 20
        }
      ],
      "input": {
        "random": 0.8,
        "now": 1000
      },
      "expected": "overflow"
    },
    {
      "name": "random 0.999 picks the last key",
      "keys": [
        {
          "alias": "primary",
          "weight": 50
        },
        {
          "alias": "secondary",
          "weight": 30
        },
        {
          "alias": "overflow",
          "weight": 20
        }
      ],
      "input": {
        "random": 0.999,
        "now": 1000
      },
      "expected": "overflow"
    },
    {
      "name": "a key cooling down is left out and weights rescale",
      "keys": [
        {
          "alias": "primary",
          "weight": 50
        },
        {
          "alias": "secondary",
          "weight": 30
        },
        {
          "alias": "overflow",
          "weight": 20
        }
      ],
      "input": {
        "random": 0.6,
        "now": 1000,
        "coolingUntil": {
          "primary": 5000
        }
      },
      "expected": "overflow"
    },
    {
      "name": "a key whose cooldown has ended is used again",
      "keys": [
        {
          "alias": "primary",
          "weight": 50
        },
        {
          "alias": "secondary",
          "weight": 30
        },
        {
          "alias": "overflow",
          "weight": 20
        }
      ],
      "input": {
        "random": 0,
        "now": 5000,
        "coolingUntil": {
          "primary": 5000
        }
      },
      "expected": "primary"
    },
    {
      "name": "keys already tried for the call are left out",
      "keys": [
        {
          "alias": "primary",
          "weight": 50
        },
        {
          "alias": "secondary",
          "weight": 30
        },
        {
          "alias": "overflow",
          "weight": 20
        }
      ],
      "input": {
        "random": 0,
        "now": 1000,
        "exclude": ["primary"]
      },
      "expected": "secondary"
    },
    {
      "name": "when every key is cooling down, the one available first",
      "keys": [
        {
          "alias": "primary",
          "weight": 50
        },
        {
          "alias": "secondary",
          "weight": 30
        },
        {
          "alias": "overflow",
          "weight": 20
        }
      ],
      "input": {
        "random": 0,
        "now": 1000,
        "coolingUntil": {
          "primary": 9000,
          "secondary": 4000,
          "overflow": 4000
        }
      },
      "expected": "secondary"
    },
    {
      "name": "when every key was tried, none",
      "keys": [
        {
          "alias": "primary",
          "weight": 50
        },
        {
          "alias": "secondary",
          "weight": 30
        },
        {
          "alias": "overflow",
          "weight": 20
        }
      ],
      "input": {
        "random": 0.3,
        "now": 1000,
        "exclude": ["primary", "secondary", "overflow"]
      },
      "expected": null
    }
  ]
