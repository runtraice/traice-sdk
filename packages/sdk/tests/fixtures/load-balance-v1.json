          },
          "requireEquivalencePct": null,
          "modelAllowlist": []
        },
        {
          "id": "everything",
          "name": "everything",
          "state": "ACTIVE",
          "priority": 5,
          "condition": {
            "type": "always"
          },
          "action": "LOAD_BALANCE",
          "actionParams": {
            "keys": [
              {
                "alias": "primary",
                "weight": 50
              },
              {
                "alias": "secondary",
                "weight": 30
              },
              {
                "alias": "overflow",
                "weight": 20
              }
            ],
            "onRateLimit": "next_key",
            "cooldownMs": 30000
          },
          "requireEquivalencePct": null,
          "modelAllowlist": []
        }
      ],
      "expectedMatch": {
        "ruleId": "everything",
        "ruleName": "everything",
        "mode": "active",
        "keys": [
          {
            "alias": "primary",
            "weight": 50
          },
          {
            "alias": "secondary",
            "weight": 30
          },
          {
            "alias": "overflow",
            "weight": 20
          }
        ],
        "onRateLimit": "next_key",
        "cooldownMs": 30000
      },
      "expectedDecision": {
        "matched": false,
        "action": "PASS_THROUGH",
        "ruleId": null
      }
    },
