{
  "protocolVersion": 5,
  "matchCases": [
    {
      "name": "a load-balancing rule never stops a later rule from deciding",
      "request": {
        "model": "gpt-4.1-mini",
        "feature": "chat"
      },
      "rules": [
        {
          "id": "spread",
          "name": "spread",
          "state": "ACTIVE",
          "priority": 1,
          "condition": {
            "type": "always"
          },
          "action": "LOAD_BALANCE",
          "actionParams": {
            "keys": [
              {
                "alias": "primary",
                "weight": 50
              },
              {
                "alias": "secondary",
                "weight": 30
              },
              {
                "alias": "overflow",
                "weight": 20
              }
            ],
            "onRateLimit": "next_key",
            "cooldownMs": 30000
          },
          "requireEquivalencePct": null,
          "modelAllowlist": []
        },
        {
          "id": "cache",
          "name": "cache",
          "state": "ACTIVE",
          "priority": 20,
          "condition": {
            "type": "always"
          },
          "action": "CACHE_EXACT",
          "actionParams": {
            "cacheTtlSec": 300
          },
          "requireEquivalencePct": null,
          "modelAllowlist": []
        }
      ],
      "expectedMatch": {
        "ruleId": "spread",
        "ruleName": "spread",
        "mode": "active",
        "keys": [
          {
            "alias": "primary",
            "weight": 50
          },
          {
            "alias": "secondary",
            "weight": 30
          },
          {
            "alias": "overflow",
            "weight": 20
          }
        ],
        "onRateLimit": "next_key",
        "cooldownMs": 30000
      },
      "expectedDecision": {
        "action": "CACHE_EXACT",
        "ruleId": "cache",
        "mode": "active"
      }
    },
    {
