      },
      "expectedInput": "{\"request\":{\"messages\":[{\"content\":\"Order 42?\",\"role\":\"user\"}],\"model\":\"gpt-5.5-mini\",\"response_format\":{\"type\":\"json_object\"},\"tools\":[{\"function\":{\"name\":\"lookup_order\",\"parameters\":{\"properties\":{\"id\":{\"type\":\"string\"}},\"type\":\"object\"}},\"type\":\"function\"}]},\"ruleId\":\"rule_cache_faq\",\"v\":\"shared-exact-v1\"}",
      "expectedKey": "a2bf613f409478b6483ee31717f846680f2be154e1f4edb57892f073dfda9f0c"
    }
  ]
