    {
      "name": "tools and response format are part of the key",
      "keySalt": "c2hhcmVkLWNhY2hlLWZpeHR1cmUtc2FsdA",
      "ruleId": "rule_cache_faq",
      "request": {
        "model": "gpt-5.5-mini",
        "messages": [
          {
            "role": "user",
            "content": "Order 42?"
          }
        ],
        "tools": [
          {
            "type": "function",
            "function": {
              "name": "lookup_order",
              "parameters": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        ],
        "response_format": {
          "type": "json_object"
