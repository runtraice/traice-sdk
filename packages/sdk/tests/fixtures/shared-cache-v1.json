{
  "protocol": "shared-exact-v1",
  "description": "Key = lowercase hex HMAC-SHA256(keySalt, expectedInput). expectedInput = canonical JSON of {v, ruleId, request}: object keys sorted by UTF-16 code unit, undefined members dropped, array order kept.",
  "cases": [
    {
      "name": "a chat request keys on rule and the whole request",
      "keySalt": "c2hhcmVkLWNhY2hlLWZpeHR1cmUtc2FsdA",
      "ruleId": "rule_cache_faq",
      "request": {
        "model": "gpt-5.5-mini",
        "messages": [
          {
            "role": "user",
            "content": "What is our refund window?"
          }
        ],
        "temperature": 0
      },
      "expectedInput": "{\"request\":{\"messages\":[{\"content\":\"What is our refund window?\",\"role\":\"user\"}],\"model\":\"gpt-5.5-mini\",\"temperature\":0},\"ruleId\":\"rule_cache_faq\",\"v\":\"shared-exact-v1\"}",
      "expectedKey": "8074bccc170e31b2814d235848379fcc6e372bf29c6986ef54304f9340d97a01"
    },
    {
      "name": "member order and undefined members do not change the key",
      "keySalt": "c2hhcmVkLWNhY2hlLWZpeHR1cmUtc2FsdA",
      "ruleId": "rule_cache_faq",
      "request": {
        "temperature": 0,
        "messages": [
          {
            "content": "What is our refund window?",
            "role": "user"
          }
        ],
        "model": "gpt-5.5-mini"
      },
      "expectedInput": "{\"request\":{\"messages\":[{\"content\":\"What is our refund window?\",\"role\":\"user\"}],\"model\":\"gpt-5.5-mini\",\"temperature\":0},\"ruleId\":\"rule_cache_faq\",\"v\":\"shared-exact-v1\"}",
      "expectedKey": "8074bccc170e31b2814d235848379fcc6e372bf29c6986ef54304f9340d97a01"
    },
    {
      "name": "another rule gets another key",
