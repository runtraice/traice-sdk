      "expectedInput": "{\"request\":{\"messages\":[{\"content\":\"What is our refund window?\",\"role\":\"user\"}],\"model\":\"gpt-5.5-mini\",\"temperature\":0},\"ruleId\":\"rule_cache_other\",\"v\":\"shared-exact-v1\"}",
      "expectedKey": "a94a9d6c95e645425374a518784e70ad72516cfb10b269a67f318a8af8626861"
